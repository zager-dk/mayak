<Window x:Class="MayakVPN.Views.RelayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход через другой сервер" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="24,18,24,20">
        <TextBlock Style="{StaticResource H2}" Text="Вход через другой сервер (каскад)" />
        <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,6">
            Пользователи подключаются к входному серверу (например, VPS Timeweb в Москве), а он пересылает зашифрованный трафик на основной сервер. Так обходятся блокировки IP основного сервера и «белые списки». Вход ничего не расшифровывает и не хранит ключей.
        </TextBlock>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Входной сервер (чистый VPS: Ubuntu 22.04/24.04 или Debian 12, доступ root)" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="+ Новый сервер…" Click="AddNew" Margin="8,0,0,0" />
            <ComboBox x:Name="RelayBox" DisplayMemberPath="Name" />
        </DockPanel>
        <TextBlock x:Name="RelayHostText" Style="{StaticResource Hint}" />

        <CheckBox x:Name="ManageCheck" IsChecked="True" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap" Text="Управлять основным сервером через вход (SSH пробрасывается на порт входа) — Маяк будет работать без стороннего VPN" />
        </CheckBox>
        <DockPanel Margin="22,6,0,0">
            <TextBlock Text="Порт SSH на входе:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
            <TextBox x:Name="SshPortBox" Text="22022" Width="90" HorizontalAlignment="Left" />
        </DockPanel>

        <Border Background="#FFF7E6" BorderBrush="#F3D39A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#5C3B00"
                       Text="После настройки адрес во всех файлах подключения станет адресом входа — выдайте пользователям файлы заново. Порты на входе те же, что на основном сервере." />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="Настроить вход" IsDefault="True" Click="Ok" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
