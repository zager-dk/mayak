<Window x:Class="MayakVPN.Views.GrantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выдать доступ по списку" Width="560" Height="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <DockPanel Margin="22,16,22,18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H2}" x:Name="Header" Text="Выдать доступ по списку" Margin="0" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,10"
                       Text="Маяк заведёт на сервере недостающих пользователей и устройства, а файлы для всех отмеченных сохранит в папку. Уже выданные ключи не меняются." />
            <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource LinkButton}" Content="Все" Click="SelectAll" />
                    <Button Style="{StaticResource LinkButton}" Content="Только новые" Click="SelectNew" />
                    <Button Style="{StaticResource LinkButton}" Content="Никого" Click="SelectNone" Margin="0" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Изменить список…" Click="EditList" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="Выдать доступ" IsDefault="True" Click="Ok" Margin="0" />
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <ListBox x:Name="PeopleList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,9">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="CheckChanged" VerticalContentAlignment="Top">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
