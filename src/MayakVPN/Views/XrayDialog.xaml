<Window x:Class="MayakVPN.Views.XrayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка Xray" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="24,18,24,20">
        <TextBlock Style="{StaticResource H2}" x:Name="Header" Text="Xray: VLESS + Reality + XHTTP" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                   Text="Запасной протокол поверх TCP. Трафик выглядит как обращение к сайту, указанному ниже. Ставится рядом с AmneziaWG и выдаётся всем активным устройствам." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="TCP-порт" />
                <TextBox x:Name="PortBox" Text="443" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Сайт для маскировки Reality" />
                <ComboBox x:Name="SniBox" IsEditable="True" />
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Text="443 — обычный порт HTTPS, выглядит естественнее всего. Если на сервере уже есть сайт на 443, выберите другой порт (например, 8443)." />

        <Border x:Name="ReinstallWarning" Background="#FDECEC" BorderBrush="#F2B8B8" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="#8A1F1F"
                       Text="Ключи Reality будут созданы заново: Xray в уже выданных файлах перестанет работать (AmneziaWG продолжит)." />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" x:Name="OkButton" Content="Установить" IsDefault="True" Click="Ok" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
