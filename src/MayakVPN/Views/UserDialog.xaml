<Window x:Class="MayakVPN.Views.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="24,18,24,20">
        <TextBlock Style="{StaticResource H2}" x:Name="Header" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Имя" Margin="0,4,0,4" />
        <TextBox x:Name="NameBox" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Заметка (необязательно): контакт, оплата до…" />
        <TextBox x:Name="NoteBox" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" IsDefault="True" Click="Ok" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
