<Window x:Class="MayakVPN.Views.AdoptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Привязка подключения" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="24,18,24,20">
        <TextBlock Style="{StaticResource H2}" Text="Привязать к пользователю" />
        <TextBlock Style="{StaticResource Hint}" x:Name="PeerText" Margin="0,0,0,4" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Пользователь" />
        <ComboBox x:Name="UserBox" DisplayMemberPath="Name" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Тип устройства" />
        <ComboBox x:Name="KindBox" DisplayMemberPath="Title" />

        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                   Text="Устройство появится у пользователя со статистикой и лимитом скорости по умолчанию. Выдать для него файл не получится — при необходимости создайте новое устройство." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="Привязать" IsDefault="True" Click="Ok" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
