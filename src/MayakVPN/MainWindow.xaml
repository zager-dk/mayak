<Window x:Class="MayakVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MayakVPN.Views"
        Title="Маяк VPN" Width="1200" Height="760" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/mayak.ico"
        Style="{StaticResource BaseWindow}">
    <Window.Resources>
        <v:BoolToVisibility x:Key="BoolVis" />
        <v:NotEmptyToVisibility x:Key="NotEmptyVis" />
        <v:StatusToBrush x:Key="StatusBrush" />

        <!-- Строка списка в карточке: подсветка и янтарная метка выбора -->
        <Style x:Key="CardListItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="14,9" Background="Transparent" Cursor="Hand"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F7F9FB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF4DD" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Amber}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════ Боковая панель ═══════════ -->
        <Border Background="{StaticResource Navy}">
            <DockPanel Margin="12,16,12,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Image Source="pack://application:,,,/Assets/mayak.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Маяк VPN" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource SidebarLink}" Command="{Binding ShowPeopleCommand}"
                            ToolTip="Постоянный список людей и их устройств — общий для всех серверов">
                        <TextBlock><Run Text="☰" FontSize="14" /><Run Text="   Список людей" /></TextBlock>
                    </Button>
                    <Button Style="{StaticResource SidebarLink}" Command="{Binding CheckAddressCommand}"
                            ToolTip="Доступен ли IP нового сервера из России — до установки VPN">
                        <TextBlock><Run Text="⌕" FontSize="15" /><Run Text="   Проверить адрес…" /></TextBlock>
                    </Button>
                    <Button Style="{StaticResource SidebarLink}" Command="{Binding OpenExportFolderCommand}" ToolTip="{Binding ExportFolder}">
                        <TextBlock><Run Text="▤" FontSize="14" /><Run Text="   Папка с файлами" /></TextBlock>
                    </Button>
                </StackPanel>

                <DockPanel DockPanel.Dock="Top" Margin="6,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SidebarIconButton}" Content="+" ToolTip="Добавить сервер"
                            Command="{Binding AddServerCommand}" />
                    <TextBlock Text="СЕРВЕРЫ" Foreground="#7D8BA0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Servers_DoubleClick">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Настройки подключения…" Command="{Binding EditServerCommand}" />
                            <MenuItem Header="Проверить адрес…" Command="{Binding CheckAddressCommand}" />
                            <Separator />
                            <MenuItem Header="Убрать из списка" Command="{Binding RemoveServerCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="6" Padding="10,8" Margin="0,0,0,2" Background="Transparent" Cursor="Hand">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1C2C44" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelected}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="#8C9AAE" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══════════ Основная часть ═══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <DockPanel Margin="28,20,20,6" Visibility="{Binding HasServer, Converter={StaticResource BoolVis}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Content="⟳" ToolTip="Обновить" Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="⋯" ToolTip="Ещё" Click="OpenMenu" FontWeight="Bold">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Настройки подключения…" Command="{Binding EditServerCommand}" />
                                <MenuItem Header="Проверить адрес…" Command="{Binding CheckAddressCommand}" />
                                <Separator />
                                <MenuItem Header="Убрать из списка" Command="{Binding RemoveServerCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="{Binding SelectedServer.Name}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{Binding IsInstalled, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="  ·  " Foreground="{StaticResource Muted}" Visibility="{Binding SummaryText, Converter={StaticResource NotEmptyVis}}" />
                        <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Предупреждения -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Warnings}" Margin="28,0,28,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF4E0" CornerRadius="6" Padding="12,7" Margin="0,6,0,0">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#7A4B00" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Нет серверов -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="28,24,28,24" Padding="32" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="680"
                    Visibility="{Binding HasServer, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Свой VPN за три шага" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13.5" LineHeight="22" Margin="0,12,0,0">
                        1. Арендуйте VPS за рубежом (Ubuntu 22.04/24.04 или Debian 12) и сразу проверьте его адрес — из России доступны не все диапазоны.<LineBreak />
                        2. Добавьте сервер: IP, логин root и пароль из письма хостинга. Маяк сам установит VPN.<LineBreak />
                        3. Заведите пользователей и выдайте файлы: .vpn для Windows и Android, .conf для iPhone и Mac.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Проверить адрес…" Command="{Binding CheckAddressCommand}" Padding="18,8" />
                        <Button Content="+ Добавить сервер" Command="{Binding AddServerCommand}" Padding="18,8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- VPN не установлен -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="28,12,28,24" Padding="28" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="680"
                    Visibility="{Binding NeedsInstall, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="На сервере ещё нет VPN" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13.5">
                        Маяк установит Docker, AmneziaWG и Xray, сгенерирует ключи и включит лимиты скорости. Обычно 3–7 минут.
                    </TextBlock>
                    <Button Style="{StaticResource PrimaryButton}" Content="Установить VPN…" Command="{Binding InstallCommand}"
                            HorizontalAlignment="Left" Margin="0,18,0,0" Padding="20,9" />
                </StackPanel>
            </Border>

            <!-- Входной сервер -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="28,12,28,24" Padding="28" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="720"
                    Visibility="{Binding IsRelayProfile, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Входной сервер каскада" />
                    <TextBlock Text="{Binding RelayStatusText}" TextWrapping="Wrap" FontSize="13.5" LineHeight="22" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
                        Только пересылает зашифрованный трафик на основной сервер: ключей и пользователей здесь нет. Настраивается с вкладки «Сервер» основного сервера.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="⟳  Обновить" Command="{Binding RefreshCommand}" />
                        <Button Content="Проверить адрес с этого входа…" Command="{Binding CheckAddressCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════ Вкладки ═══════════ -->
            <TabControl Grid.Row="2" Margin="28,6,28,14" Background="Transparent" BorderThickness="0" Padding="0,14,0,0"
                        SelectedIndex="{Binding TabIndex}"
                        Visibility="{Binding ShowTabs, Converter={StaticResource BoolVis}}">

                <!-- ═════ Пользователи ═════ -->
                <TabItem Header="Пользователи">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Подключения, созданные в AmneziaVPN: только если они есть -->
                        <Border Background="#EEF2F7" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                                Visibility="{Binding ForeignBannerText, Converter={StaticResource NotEmptyVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding ForeignToggleText}"
                                        Command="{Binding ToggleForeignCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ForeignBannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,12"
                                Visibility="{Binding ShowForeign, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="16,12,16,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Привязать к пользователю…" Command="{Binding AdoptForeignCommand}" />
                                        <Button Style="{StaticResource DangerButton}" Content="Отозвать" Command="{Binding RevokeForeignCommand}" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0"
                                               Text="Привяжите, чтобы видеть статистику и задать лимит. Выдать файл нельзя — ключ хранится только у получателя." />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Foreign}" SelectedItem="{Binding SelectedForeign}" BorderThickness="0,1,0,0" MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="IP в VPN" Binding="{Binding Ip}" Width="110" />
                                        <DataGridTextColumn Header="Ключ" Binding="{Binding Key}" Width="140" />
                                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="270" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Список пользователей -->
                            <Border Style="{StaticResource CardBorder}" Padding="0">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="16,12,10,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="+" FontSize="20" Padding="8,0"
                                                ToolTip="Новый пользователь" Command="{Binding AddUserCommand}" />
                                        <TextBlock Style="{StaticResource H2}" Text="Пользователи" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,10">
                                        <Button Content="Выдать доступ по списку…" Command="{Binding GrantCommand}" Margin="0"
                                                ToolTip="Завести на сервере всех из постоянного списка и сохранить файлы для всех разом" />
                                    </Border>
                                    <Grid>
                                        <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" BorderThickness="0,1,0,0"
                                                 BorderBrush="{StaticResource Line}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource CardListItem}">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Изменить…" Command="{Binding EditUserCommand}" />
                                                    <MenuItem Header="{Binding ToggleUserText}" Command="{Binding ToggleUserCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="Удалить" Command="{Binding DeleteUserCommand}" />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                 Fill="{Binding IsOnline, Converter={StaticResource StatusBrush}}" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding Users.Count, Converter={StaticResource NotEmptyVis}, ConverterParameter=invert}">
                                            <TextBlock Text="Пока никого нет" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="Выдать доступ по списку…" Command="{Binding GrantCommand}"
                                                    Margin="0,10,0,0" HorizontalAlignment="Center" />
                                            <Button Style="{StaticResource LinkButton}" Content="или добавить одного" Command="{Binding AddUserCommand}"
                                                    Margin="0,8,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <!-- Устройства выбранного пользователя -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="18,12,14,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                                    Visibility="{Binding HasSelectedUser, Converter={StaticResource BoolVis}}">
                                            <Button Content="Выдать файл / QR" Command="{Binding ShareDeviceCommand}" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="+ Устройство" Command="{Binding AddDeviceCommand}" />
                                            <Button Style="{StaticResource IconButton}" Content="⋯" FontWeight="Bold" ToolTip="Устройство" Click="OpenMenu">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Изменить и лимит скорости…" Command="{Binding EditDeviceCommand}" />
                                                        <MenuItem Header="{Binding ToggleDeviceText}" Command="{Binding ToggleDeviceCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="Удалить устройство" Command="{Binding DeleteDeviceCommand}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource H2}" Text="{Binding UserTitle}" Margin="0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SelectedUser.Note}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                                       Visibility="{Binding SelectedUser.Note, Converter={StaticResource NotEmptyVis}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding HasSelectedUser, Converter={StaticResource BoolVis}}">
                                                <Button Style="{StaticResource LinkButton}" Content="Изменить" Command="{Binding EditUserCommand}" />
                                                <Button Style="{StaticResource LinkButton}" Content="{Binding ToggleUserText}" Command="{Binding ToggleUserCommand}" />
                                                <Button Style="{StaticResource DangerLink}" Content="Удалить пользователя" Command="{Binding DeleteUserCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" BorderThickness="0,1,0,0"
                                                  MouseDoubleClick="DevicesGrid_DoubleClick">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Выдать файл / QR…" Command="{Binding ShareDeviceCommand}" FontWeight="SemiBold" />
                                                    <MenuItem Header="Изменить и лимит скорости…" Command="{Binding EditDeviceCommand}" />
                                                    <MenuItem Header="{Binding ToggleDeviceText}" Command="{Binding ToggleDeviceCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="Удалить устройство" Command="{Binding DeleteDeviceCommand}" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Статус" Width="150">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                                                <TextBlock Text="{Binding Status}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Устройство" Binding="{Binding Name}" Width="*" MinWidth="110" />
                                                <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="80" />
                                                <DataGridTextColumn Header="Протоколы" Binding="{Binding Protocols}" Width="90" />
                                                <DataGridTextColumn Header="Лимит" Binding="{Binding Limit}" Width="130" />
                                                <DataGridTextColumn Header="Трафик" Binding="{Binding Traffic}" Width="140" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding Devices.Count, Converter={StaticResource NotEmptyVis}, ConverterParameter=invert}">
                                            <TextBlock Text="Нет устройств" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Двойной щелчок по устройству — выдать файл или QR" Style="{StaticResource Hint}" HorizontalAlignment="Center"
                                                       Visibility="{Binding HasSelectedUser, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ═════ Проверка ═════ -->
                <TabItem Header="Проверка">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}" Padding="18,14">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Остановить" Command="{Binding CancelCheckCommand}"
                                                    Visibility="{Binding CheckRunning, Converter={StaticResource BoolVis}}" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="Запустить проверку" Command="{Binding RunCheckCommand}" Padding="18,8" Margin="0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource H2}" Text="Какие протоколы проходят из этой сети" Margin="0" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                                       Text="Выключите другой VPN на компьютере. Для мобильного интернета раздайте его с телефона по Wi-Fi." />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock Text="Сеть:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding CheckNetworkLabel, UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"
                                                 ToolTip="Подпись для истории, например «Дом, Ростелеком» или «МТС, мобильный»" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding OfflineCheckText}" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Visibility="{Binding OfflineCheckText, Converter={StaticResource NotEmptyVis}}" />
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding CheckRunning, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding CheckProgress}" />
                                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" Foreground="{StaticResource Amber}" BorderThickness="0" />
                                    </StackPanel>
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Hint}" Visibility="{Binding CheckClientAddress, Converter={StaticResource NotEmptyVis}}">
                                        <Run Text="Сервер видит компьютер с адреса " /><Run Text="{Binding CheckClientAddress, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Если это не адрес вашего провайдера — включён другой VPN." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,12,0,0"
                                    Visibility="{Binding CheckLines.Count, Converter={StaticResource NotEmptyVis}}">
                                <ItemsControl ItemsSource="{Binding CheckLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Margin="0,0,14,0" VerticalAlignment="Top"
                                                            Background="{Binding StatusKind, Converter={StaticResource StatusBrush}}">
                                                        <TextBlock Text="{Binding Icon}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock>
                                                            <Run Text="{Binding Protocol, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" /><Run Text="  ·  " Foreground="{StaticResource Muted}" /><Run Text="{Binding Summary, Mode=OneWay}" FontSize="14" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Border Background="#FFF4E0" CornerRadius="8" Padding="16,12" Margin="0,12,0,0"
                                    Visibility="{Binding CheckRecommendation, Converter={StaticResource NotEmptyVis}}">
                                <TextBlock Text="{Binding CheckRecommendation}" TextWrapping="Wrap" Foreground="#5C3B00" />
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,12,0,0"
                                    Visibility="{Binding CheckHistory.Count, Converter={StaticResource NotEmptyVis}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="История" Margin="18,12,18,8" />
                                    <DataGrid ItemsSource="{Binding CheckHistory}" BorderThickness="0,1,0,0" MaxHeight="280">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Когда" Binding="{Binding When}" Width="95" />
                                            <DataGridTextColumn Header="Сеть" Binding="{Binding Network}" Width="240" />
                                            <DataGridTextColumn Header="Результат" Binding="{Binding Results}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═════ Сервер ═════ -->
                <TabItem Header="Сервер">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <!-- VPN -->
                                <Border Style="{StaticResource CardBorder}" Padding="18,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⋯" FontWeight="Bold" ToolTip="Ещё" Click="OpenMenu" VerticalAlignment="Top">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Запустить контейнер" Command="{Binding StartCommand}" />
                                                        <MenuItem Header="{Binding InstallButtonText}" Command="{Binding InstallCommand}" />
                                                        <MenuItem Header="{Binding XrayButtonText}" Command="{Binding InstallXrayCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="Удалить Xray" Command="{Binding UninstallXrayCommand}" />
                                                        <MenuItem Header="Удалить VPN с сервера" Command="{Binding UninstallCommand}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <TextBlock Style="{StaticResource H2}" Text="VPN" />
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource KeyText}" Text="Состояние" />
                                            <TextBlock Style="{StaticResource ValueText}" Grid.Column="1" Text="{Binding StateText}" />
                                            <TextBlock Style="{StaticResource KeyText}" Grid.Row="1" Text="Адрес" />
                                            <TextBlock Style="{StaticResource ValueText}" Grid.Row="1" Grid.Column="1" Text="{Binding EndpointText}" />
                                            <TextBlock Style="{StaticResource KeyText}" Grid.Row="2" Text="AmneziaWG" />
                                            <TextBlock Style="{StaticResource ValueText}" Grid.Row="2" Grid.Column="1" Text="{Binding ProtocolText}" />
                                            <TextBlock Style="{StaticResource KeyText}" Grid.Row="3" Text="Xray" />
                                            <TextBlock Style="{StaticResource ValueText}" Grid.Row="3" Grid.Column="1">
                                                <Run Text="{Binding XrayStateText, Mode=OneWay}" /><LineBreak /><Run Text="{Binding XrayEndpointText, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12" />
                                            </TextBlock>
                                        </Grid>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="Перезапустить" Command="{Binding RestartCommand}" Margin="0,0,8,0" />
                                            <Button Content="{Binding XrayButtonText}" Command="{Binding InstallXrayCommand}" Margin="0,0,8,0"
                                                    Visibility="{Binding HasXray, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                                   Text="Переустановка (меню ⋯) меняет ключи сервера — файлы придётся выдать заново." />
                                    </StackPanel>
                                </Border>

                                <!-- Каскад -->
                                <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Вход через другой сервер" />
                                        <TextBlock Text="{Binding RelayText}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Настроить вход…" Command="{Binding SetupRelayCommand}" />
                                            <Button Style="{StaticResource DangerLink}" Content="Отключить" Command="{Binding RemoveRelayCommand}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                                   Text="Пользователи подключаются к серверу в России, он пересылает трафик сюда. Помогает при «белых списках», если вход видит этот сервер." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Настройки -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,14" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Настройки" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Название в приложении AmneziaVPN" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SetTitle, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Адрес в файлах подключения (пусто — как для SSH)" />
                                    <TextBox Text="{Binding SetEndpointHost, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="DNS для клиентов" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SetDns1, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Text="{Binding SetDns2, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Лимит скорости по умолчанию, Мбит/с: приём / отдача (0 — без лимита)" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SetDefaultDown, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Text="{Binding SetDefaultUp, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="YouTube в 4K — около 20–25 Мбит/с, 35 — с запасом." />
                                    <CheckBox Content="Применить ко всем существующим устройствам" IsChecked="{Binding ApplyDefaultsToAll}" Margin="0,10,0,0" />

                                    <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Command="{Binding SaveSettingsCommand}"
                                            HorizontalAlignment="Left" Margin="0,16,0,0" />

                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Сменить…" Command="{Binding ChangeExportFolderCommand}"
                                                    Margin="12,0,0,0" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Папка для выданных файлов (на этом компьютере)" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding ExportFolder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExportFolder}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ═════ Журнал ═════ -->
                <TabItem Header="Журнал">
                    <Border Style="{StaticResource CardBorder}" Padding="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="18,10,12,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Очистить" Command="{Binding ClearLogCommand}" Margin="0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource H2}" Text="Журнал операций" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8" />
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- Строка состояния -->
            <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Card}" Padding="28,6">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Индикатор работы -->
            <Border Grid.RowSpan="4" Background="#99F4F6F9" Visibility="{Binding BusyText, Converter={StaticResource NotEmptyVis}}">
                <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" MinWidth="360">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="420" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" Foreground="{StaticResource Amber}" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
