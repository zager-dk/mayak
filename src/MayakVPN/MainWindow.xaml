<Window x:Class="MayakVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MayakVPN.Views"
        Title="Маяк VPN" Width="1240" Height="780" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/mayak.ico"
        Style="{StaticResource BaseWindow}">
    <Window.Resources>
        <v:BoolToVisibility x:Key="BoolVis" />
        <v:NotEmptyToVisibility x:Key="NotEmptyVis" />
        <v:StatusToBrush x:Key="StatusBrush" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ─────────── Боковая панель: серверы ─────────── -->
        <Border Background="{StaticResource Navy}">
            <DockPanel Margin="16,18,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,24">
                    <Image Source="pack://application:,,,/Assets/mayak.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Маяк VPN" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="панель администратора" Foreground="#8C9AAE" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="ПАПКА С ФАЙЛАМИ" Foreground="#7D8BA0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ExportFolder}" Foreground="{StaticResource SidebarText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SidebarButton}" Content="Открыть" Command="{Binding OpenExportFolderCommand}" />
                        <Button Style="{StaticResource SidebarButton}" Content="Сменить…" Command="{Binding ChangeExportFolderCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="СЕРВЕРЫ" Foreground="#7D8BA0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Style="{StaticResource SidebarButton}" Content="+ Добавить" Command="{Binding AddServerCommand}" />
                    <Button Style="{StaticResource SidebarButton}" Content="Изменить" Command="{Binding EditServerCommand}" />
                    <Button Style="{StaticResource SidebarButton}" Content="✕" ToolTip="Убрать из списка" Command="{Binding RemoveServerCommand}" Margin="0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,16"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent" Cursor="Hand">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelected}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1C2C44" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="#8C9AAE" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ─────────── Основная часть ─────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <DockPanel Margin="24,18,24,8" Visibility="{Binding HasServer, Converter={StaticResource BoolVis}}">
                <Button DockPanel.Dock="Right" Content="⟳  Обновить" Command="{Binding RefreshCommand}" Margin="0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="{Binding SelectedServer.Name}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{Binding IsInstalled, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="  ·  " Foreground="{StaticResource Muted}" Visibility="{Binding SummaryText, Converter={StaticResource NotEmptyVis}}" />
                        <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Предупреждения -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Warnings}" Margin="24,0,24,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF4E0" BorderBrush="#F3D39A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#7A4B00" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Пустое состояние: нет серверов -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="24" Padding="32" VerticalAlignment="Top"
                    Visibility="{Binding HasServer, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H1}" Text="Добро пожаловать в Маяк VPN" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13.5" Margin="0,12,0,0">
                        1. Арендуйте VPS за пределами России (Ubuntu 22.04/24.04 или Debian 12, от 1 ГБ памяти).<LineBreak />
                        2. Нажмите «+ Добавить» слева и введите IP сервера, логин root и пароль из письма хостинга.<LineBreak />
                        3. Маяк сам установит Docker и AmneziaWG и настроит сервер.<LineBreak />
                        4. Заведите постоянных пользователей и выдайте им файлы: .vpn для Windows и Android, .conf для iPhone и Mac.
                    </TextBlock>
                    <Button Style="{StaticResource PrimaryButton}" Content="+ Добавить сервер" Command="{Binding AddServerCommand}"
                            HorizontalAlignment="Left" Margin="0,20,0,0" Padding="20,9" />
                </StackPanel>
            </Border>

            <!-- Сервер не настроен -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="24,8,24,24" Padding="28" VerticalAlignment="Top"
                    Visibility="{Binding NeedsInstall, Converter={StaticResource BoolVis}}">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H2}" Text="На сервере ещё нет VPN" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13.5">
                        Маяк установит Docker, соберёт контейнер AmneziaWG (как это делает приложение AmneziaVPN), сгенерирует ключи и включит лимиты скорости. Обычно это занимает 3–7 минут.
                    </TextBlock>
                    <Button Style="{StaticResource PrimaryButton}" Content="Установить VPN…" Command="{Binding InstallCommand}"
                            HorizontalAlignment="Left" Margin="0,18,0,0" Padding="20,9" />
                </StackPanel>
            </Border>

            <!-- Входной сервер -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="24,8,24,24" Padding="28" VerticalAlignment="Top"
                    Visibility="{Binding IsRelayProfile, Converter={StaticResource BoolVis}}">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H2}" Text="Входной сервер каскада" />
                    <TextBlock Text="{Binding RelayStatusText}" TextWrapping="Wrap" FontSize="13.5" LineHeight="22" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
                        Этот сервер только пересылает зашифрованный трафик на основной: ключей и пользователей на нём нет. Пересылка переживает перезагрузку (служба mayak-relay). Управление — на вкладке «Сервер» основного сервера.
                    </TextBlock>
                    <Button Content="⟳  Проверить" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- Вкладки -->
            <TabControl Grid.Row="2" Margin="24,4,24,12" Background="Transparent" BorderThickness="0" Padding="0,12,0,0"
                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">

                <!-- ═════ Пользователи ═════ -->
                <TabItem Header="Пользователи">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="16,14,12,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ Пользователь" Command="{Binding AddUserCommand}" Margin="0" Padding="12,6" />
                                    <TextBlock Style="{StaticResource H2}" Text="Пользователи" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
                                    <Button Content="Изменить" Command="{Binding EditUserCommand}" Margin="0,0,6,6" Padding="10,6" />
                                    <Button Content="{Binding ToggleUserText}" Command="{Binding ToggleUserCommand}" Margin="0,0,6,6" Padding="10,6" />
                                    <Button Style="{StaticResource DangerButton}" Content="Удалить" Command="{Binding DeleteUserCommand}" Margin="0,0,0,6" Padding="10,6" />
                                </WrapPanel>
                                <Grid>
                                    <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" BorderThickness="0,1,0,1"
                                             BorderBrush="{StaticResource Line}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" Padding="16,9" Background="Transparent" Cursor="Hand"
                                                                    BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#F7F9FB" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#FFF4DD" />
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Amber}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                             Fill="{Binding IsOnline, Converter={StaticResource StatusBrush}}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Пока никого нет.&#x0a;Нажмите «+ Пользователь»." Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               Visibility="{Binding Users.Count, Converter={StaticResource NotEmptyVis}, ConverterParameter=invert}" />
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding DevicesHeader}" Margin="0" />
                                    <TextBlock Text="{Binding SelectedUser.Note}" Style="{StaticResource Hint}"
                                               Visibility="{Binding SelectedUser.Note, Converter={StaticResource NotEmptyVis}}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="+ Устройство" Command="{Binding AddDeviceCommand}" Margin="0,0,8,6" />
                                        <Button Content="Выдать файл / QR" Command="{Binding ShareDeviceCommand}" Margin="0,0,8,6" />
                                        <Button Content="Изменить и лимит" Command="{Binding EditDeviceCommand}" Margin="0,0,8,6" />
                                        <Button Content="{Binding ToggleDeviceText}" Command="{Binding ToggleDeviceCommand}" Margin="0,0,8,6" />
                                        <Button Style="{StaticResource DangerButton}" Content="Удалить" Command="{Binding DeleteDeviceCommand}" Margin="0,0,0,6" />
                                    </WrapPanel>
                                </StackPanel>
                                <Grid>
                                    <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" BorderThickness="0,1,0,0"
                                              MouseDoubleClick="DevicesGrid_DoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Статус" Width="160">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                                            <TextBlock Text="{Binding Status}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Устройство" Binding="{Binding Name}" Width="*" MinWidth="110" />
                                            <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="80" />
                                            <DataGridTextColumn Header="Протоколы" Binding="{Binding Protocols}" Width="90" />
                                            <DataGridTextColumn Header="Файл" Binding="{Binding FileFormat}" Width="55" />
                                            <DataGridTextColumn Header="IP в VPN" Binding="{Binding Ip}" Width="95" />
                                            <DataGridTextColumn Header="Лимит" Binding="{Binding Limit}" Width="140" />
                                            <DataGridTextColumn Header="Трафик" Binding="{Binding Traffic}" Width="150" />
                                            <DataGridTextColumn Header="Выдано" Binding="{Binding Created}" Width="85" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="У пользователя нет устройств.&#x0a;Нажмите «+ Устройство», чтобы выдать доступ." Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               Visibility="{Binding Devices.Count, Converter={StaticResource NotEmptyVis}, ConverterParameter=invert}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ═════ Сервер ═════ -->
                <TabItem Header="Сервер">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Состояние" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Состояние" Foreground="{StaticResource Muted}" Margin="0,4" />
                                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Margin="0,4" />
                                            <TextBlock Grid.Row="1" Text="Адрес для клиентов" Foreground="{StaticResource Muted}" Margin="0,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EndpointText}" Margin="0,4" />
                                            <TextBlock Grid.Row="2" Text="Протокол" Foreground="{StaticResource Muted}" Margin="0,4" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProtocolText}" Margin="0,4" />
                                            <TextBlock Grid.Row="3" Text="Контейнер" Foreground="{StaticResource Muted}" Margin="0,4" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="amnezia-awg2 (совместим с AmneziaVPN)" Margin="0,4" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Обслуживание" />
                                        <WrapPanel>
                                            <Button Content="Запустить" Command="{Binding StartCommand}" Margin="0,0,8,8" />
                                            <Button Content="Перезапустить VPN" Command="{Binding RestartCommand}" Margin="0,0,8,8" />
                                            <Button Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" Margin="0,0,8,8" />
                                            <Button Style="{StaticResource DangerButton}" Content="Удалить VPN с сервера" Command="{Binding UninstallCommand}" Margin="0,0,8,8" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Hint}">
                                            Перезапуск занимает несколько секунд: подключения переподнимутся сами. Переустановка меняет ключи сервера — всем придётся выдать файлы заново.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Вход через другой сервер (каскад)" />
                                        <TextBlock Text="{Binding RelayText}" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Настроить вход…" Command="{Binding SetupRelayCommand}" Margin="0,0,8,8" />
                                            <Button Style="{StaticResource DangerButton}" Content="Отключить вход" Command="{Binding RemoveRelayCommand}" Margin="0,0,8,8" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Hint}">
                                            Если IP этого сервера заблокирован у пользователей, они подключаются к входному серверу (например, VPS в Москве), а он пересылает зашифрованный трафик сюда. Помогает и при «белых списках».
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Xray — запасной протокол" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Состояние" Foreground="{StaticResource Muted}" Margin="0,4" />
                                            <TextBlock Grid.Column="1" Text="{Binding XrayStateText}" Margin="0,4" />
                                            <TextBlock Grid.Row="1" Text="Параметры" Foreground="{StaticResource Muted}" Margin="0,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding XrayEndpointText}" TextWrapping="Wrap" Margin="0,4" />
                                        </Grid>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="{Binding XrayButtonText}" Command="{Binding InstallXrayCommand}" Margin="0,0,8,8" />
                                            <Button Style="{StaticResource DangerButton}" Content="Удалить Xray" Command="{Binding UninstallXrayCommand}" Margin="0,0,8,8" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Hint}">
                                            VLESS + Reality + XHTTP поверх TCP: трафик выглядит как обращение к обычному сайту. Попадает в файлы .vpn вторым протоколом. Лимиты скорости пока действуют только на AmneziaWG.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Настройки" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Название (видно в приложении AmneziaVPN у пользователей)" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SetTitle, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Адрес сервера в конфигах (IP или домен; пусто — как для SSH)" />
                                    <TextBox Text="{Binding SetEndpointHost, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="DNS для клиентов" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SetDns1, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Text="{Binding SetDns2, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Лимит скорости по умолчанию, Мбит/с (скачивание / отдача; 0 — без ограничений)" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SetDefaultDown, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Text="{Binding SetDefaultUp, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="YouTube в 4K требует около 20–25 Мбит/с; 35 — с запасом." />
                                    <CheckBox Content="Применить этот лимит ко всем существующим устройствам" IsChecked="{Binding ApplyDefaultsToAll}" Margin="0,10,0,0" />

                                    <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Command="{Binding SaveSettingsCommand}"
                                            HorizontalAlignment="Left" Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ═════ Проверка ═════ -->
                <TabItem Header="Проверка">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Какие протоколы проходят из этой сети" />
                                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,10">
                                        Маяк подключается к вашему серверу прямо с этого компьютера каждым протоколом: AmneziaWG — рукопожатие и 400 пакетов через туннель, Xray — соединение через Reality и скачивание 30 МБ. Так видно и блокировку, и «заморозку», когда соединение есть, а данные обрываются.<LineBreak />
                                        Перед проверкой выключите на компьютере любой другой VPN. Чтобы проверить мобильный интернет, раздайте его с телефона по Wi-Fi и подключите к нему компьютер.
                                    </TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Подпись сети для истории (необязательно), например «Дом, Ростелеком» или «МТС, мобильный»" />
                                            <TextBox Text="{Binding CheckNetworkLabel, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Запустить проверку" Command="{Binding RunCheckCommand}" Padding="18,8" />
                                            <Button Content="Остановить" Command="{Binding CancelCheckCommand}" Margin="0" Padding="12,8" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding CheckRunning, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding CheckProgress}" />
                                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" Foreground="{StaticResource Amber}" BorderThickness="0" />
                                    </StackPanel>
                                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Muted}" Visibility="{Binding CheckClientAddress, Converter={StaticResource NotEmptyVis}}">
                                        <Run Text="Сервер видит этот компьютер с адреса " /><Run Text="{Binding CheckClientAddress, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Если это не адрес вашего провайдера — на компьютере включён другой VPN, и результат не покажет реальную картину." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding CheckLines}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="16,12">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Margin="0,0,14,0" VerticalAlignment="Top"
                                                        Background="{Binding StatusKind, Converter={StaticResource StatusBrush}}">
                                                    <TextBlock Text="{Binding Icon}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock>
                                                        <Run Text="{Binding Protocol, Mode=OneWay}" FontWeight="SemiBold" FontSize="14.5" /><Run Text="  —  " Foreground="{StaticResource Muted}" /><Run Text="{Binding Summary, Mode=OneWay}" FontSize="14.5" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource CardBorder}" Background="#FFF7E6" BorderBrush="#F3D39A" Padding="14,10" Margin="0,0,0,12"
                                    Visibility="{Binding CheckRecommendation, Converter={StaticResource NotEmptyVis}}">
                                <TextBlock Text="{Binding CheckRecommendation}" TextWrapping="Wrap" Foreground="#5C3B00" />
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Padding="0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="История проверок" Margin="16,12,16,8" />
                                    <DataGrid ItemsSource="{Binding CheckHistory}" BorderThickness="0,1,0,0" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Когда" Binding="{Binding When}" Width="95" />
                                            <DataGridTextColumn Header="Сеть" Binding="{Binding Network}" Width="260" />
                                            <DataGridTextColumn Header="Результат" Binding="{Binding Results}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═════ Подключения из AmneziaVPN ═════ -->
                <TabItem Header="Подключения AmneziaVPN">
                    <Border Style="{StaticResource CardBorder}" Padding="0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                                <TextBlock Style="{StaticResource H2}" Text="Подключения, созданные не Маяком" Margin="0" />
                                <TextBlock Style="{StaticResource Hint}">
                                    Здесь видны ключи, выданные из официального приложения AmneziaVPN. Их можно отозвать или привязать к пользователю, чтобы видеть статистику и задать лимит скорости. Файл для них выдать нельзя — приватный ключ хранится только у получателя.
                                </TextBlock>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Привязать к пользователю…" Command="{Binding AdoptForeignCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource DangerButton}" Content="Отозвать" Command="{Binding RevokeForeignCommand}" />
                                </WrapPanel>
                            </StackPanel>
                            <Grid>
                                <DataGrid ItemsSource="{Binding Foreign}" SelectedItem="{Binding SelectedForeign}" BorderThickness="0,1,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="IP в VPN" Binding="{Binding Ip}" Width="110" />
                                        <DataGridTextColumn Header="Ключ" Binding="{Binding Key}" Width="140" />
                                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Таких подключений нет." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Foreign.Count, Converter={StaticResource NotEmptyVis}, ConverterParameter=invert}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <!-- ═════ Журнал ═════ -->
                <TabItem Header="Журнал">
                    <Border Style="{StaticResource CardBorder}" Padding="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,16,10">
                                <Button DockPanel.Dock="Right" Content="Очистить" Command="{Binding ClearLogCommand}" Margin="0" Padding="10,5" />
                                <TextBlock Style="{StaticResource H2}" Text="Журнал операций" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8" />
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- Строка состояния -->
            <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Card}" Padding="24,6">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Индикатор работы -->
            <Border Grid.RowSpan="4" Background="#99F4F6F9" Visibility="{Binding BusyText, Converter={StaticResource NotEmptyVis}}">
                <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" MinWidth="360">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="420" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" Foreground="{StaticResource Amber}" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
